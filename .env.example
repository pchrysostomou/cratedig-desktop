# cratedig-desktop backend (FastAPI) — all optional. Copy to backend/.env to override.
# Environment variables are prefixed CRATEDIG_DESKTOP_.

CRATEDIG_DESKTOP_PORT=8008
# CRATEDIG_DESKTOP_HOST=127.0.0.1
# CRATEDIG_DESKTOP_OUTPUT_DIR=C:\Users\you\Music\cratedig
# CRATEDIG_DESKTOP_DATA_DIR=C:\Users\you\AppData\Roaming\cratedig-desktop

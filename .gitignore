# ── Python (backend) ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── Node / Vite (frontend) ──
node_modules/
dist/
dist-ssr/
*.local

# ── Rust / Tauri (Phase 6) ──
src-tauri/target/
src-tauri/binaries/
backend/vendor/ffmpeg.exe
backend/vendor/ffprobe.exe
# stray install/build artifacts that can land at the repo root
/app.exe
/uninstall.exe
/cratedig-sidecar/
# never commit any Windows executable (sidecar / installer / vendored ffmpeg / etc.)
*.exe

# ── Audio: NEVER commit real music. The tiny ~4KB test fixture is the only exception. ──
*.mp3
*.m4a
*.opus
*.flac
*.wav
!backend/tests/fixtures/silence.mp3

# ── SQLite databases ──
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite

# ── Build artifacts ──
build/

# ── Env / editor / OS ──
.env
.DS_Store
.idea/
.vscode/
